{
    # Root is the Vite `dist/` directory.
    root * /usr/share/nginx/html
}

handle_path /assets/* {
    # Fingerprinted assets can be cached forever; the hash changes on every deploy.
    header CachingStrategy public
    header Cache-Control "max-age=31536000, immutable"
    try_files {path} =404
}

handle_path /index.html {
    # The shell page must never be served from cache.
    header Cache-Control "no-cache, no-store, must-revalidate"
    try_files /index.html =404
}

handle_path / {
    header Cache-Control "no-cache, no-store, must-revalidate"
    try_files /index.html =404
}

handle {
    # Any other route the SPA handles client-side.
    try_files /index.html =404
}
